# syntax=docker/dockerfile:1
ARG GO_VERSION=1.27.0
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags "-s -w" -o /out/endlessnet-relay-coordinator ./cmd/endlessnet-relay-coordinator

FROM gcr.io/distroless/static-debian13:nonroot
COPY --from=build /out/endlessnet-relay-coordinator /usr/local/bin/endlessnet-relay-coordinator
USER 65532:65532
EXPOSE 9445 7078
ENTRYPOINT ["/usr/local/bin/endlessnet-relay-coordinator"]
