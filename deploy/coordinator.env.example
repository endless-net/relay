# Relay Coordinator runtime configuration.
# Install as /etc/endlessnet-relay/coordinator.env with mode 0600.

ENDLESSNET_RELAY_COORDINATOR_GRPC_ADDR=:9445
ENDLESSNET_RELAY_COORDINATOR_HTTP_ADDR=127.0.0.1:7078
ENDLESSNET_RELAY_COORDINATOR_METRICS_ADDR=127.0.0.1:9191
ENDLESSNET_RELAY_POSTGRES_DSN=postgresql:///endlessnet_relay?host=/var/run/postgresql&user=endlessnet-relay
ENDLESSNET_COORDINATOR_URL=https://coordinator.internal.example:9447
ENDLESSNET_RELAY_ENDPOINTS_FILE=/etc/endlessnet-relay/endpoints.json
