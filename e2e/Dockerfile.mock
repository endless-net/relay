# syntax=docker/dockerfile:1@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32
ARG GO_VERSION=1.27.0
FROM golang:${GO_VERSION}-alpine@sha256:4c9fe60190a2a3350ddc51de80d0224b8a6698d12bdfc999fee45ea9d6c46dbc AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -tags=e2e -trimpath -o /out/mock-coordinator ./e2e/cmd/mock-coordinator

RUN CGO_ENABLED=0 go build -tags=e2e -trimpath -o /out/fault-proxy ./e2e/cmd/fault-proxy

FROM gcr.io/distroless/static-debian13:nonroot@sha256:1c2c046bc09ed40fad370b599a0b1ae7987f55b01e247cf27a7c27cd97e5bbc7
COPY --from=build /out/mock-coordinator /usr/local/bin/mock-coordinator
COPY --from=build /out/fault-proxy /usr/local/bin/fault-proxy
USER 65532:65532
EXPOSE 9447
ENTRYPOINT ["/usr/local/bin/mock-coordinator"]
